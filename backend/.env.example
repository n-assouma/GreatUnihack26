# Copy to backend/.env and fill in. Never commit backend/.env.

# --- LLM (Anthropic via LiteLLM) ---
ANTHROPIC_API_KEY=
# Optional: only needed if we switch LLM_MODEL to a gemini/... model
GEMINI_API_KEY=
# Main agent model. Switch to e.g. gemini/gemini-2.5-pro with no code change.
LLM_MODEL=anthropic/claude-sonnet-5
# Cheap/fast model for the guardrail classifier
GUARD_MODEL=anthropic/claude-haiku-4-5-20251001

# --- Google Routes API (outdoor journey, bus) ---
GOOGLE_MAPS_API_KEY=

# --- ElevenLabs (text to speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Demo safety nets (PLAN §5) ---
# 1 = never call the LLM, always use the D6 sentence templates
MOCK_LLM=0
# 1 = replay data/route_recorded.json instead of calling Google Routes (D5)
ROUTE_REPLAY=0
